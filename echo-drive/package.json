{
  "name": "echo-drive",
  "productName": "Echo Drive",
  "version": "0.1.0",
  "private": true,
  "description": "Echo Drive first playable \u2014 procedural night driving",
  "author": "Echo Drive contributors",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-forge package",
    "make:win": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "test:browser": "node tests/browser.cjs",
    "test:production": "node tests/offline.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "zip:win": "npm run build && electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/havok": "^1.3.10"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "playwright": "^1.56.1",
    "electron": "^39.0.0",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
